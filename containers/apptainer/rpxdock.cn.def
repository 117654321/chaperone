BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/rpxdock/files/0/rpxdock_run.py /opt/run_rpxdock.py
    /home/user/data/apptainer/sources/rpxdock/repos/0/willutil-main /opt/willutil
    /home/user/data/apptainer/sources/rpxdock/repos/0/rpxdock-main /opt/rpxdock

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # Both repos are staged from source tarballs: this host's git URL rewrite and
    # repeated GitHub disconnects make cloning them unreliable.
    python3 -m venv /opt/rpx-env
    /opt/rpx-env/bin/pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    /opt/rpx-env/bin/pip install --upgrade pip setuptools wheel

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    /opt/rpx-env/bin/pip install --no-cache-dir 'numpy==1.26.4' 'mdtraj==1.11.0' cffi tabulate
    /opt/rpx-env/bin/pip install --no-cache-dir -e /opt/willutil
    /opt/rpx-env/bin/pip install --no-cache-dir --no-deps -e /opt/rpxdock

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # Upstream indexes into a squeezed array; with a single pose .squeeze()
    # returns a 0-d array and the assignment below it fails. Keep the shape.
    # The patch text is passed via a heredoc: Apptainer's %post strips the
    # single quotes out of an inline -c string.
    cat > /tmp/patch_rpx.py <<'PATCH'
from pathlib import Path

p = Path("/opt/rpxdock/rpxdock/search/onecomp.py")
s = p.read_text()
old = "np.sum(xforms[:, :3, 3] * spec.axis[None, :3], axis=-1).squeeze()"
new = "np.sum(xforms[:, :3, 3] * spec.axis[None, :3], axis=-1).reshape(-1)"
assert s.count(old) == 1, "unexpected RPXdock onecomp source"
p.write_text(s.replace(old, new))

p = Path("/opt/rpxdock/rpxdock/search/result.py")
s = p.read_text()
old = "elif symframes == 'primary':"
new = "elif isinstance(symframes, str) and symframes == 'primary':"
assert s.count(old) == 1, "unexpected RPXdock result source"
p.write_text(s.replace(old, new))
print("rpxdock patches applied")
PATCH
    /opt/rpx-env/bin/python /tmp/patch_rpx.py
    PYTHONPATH=/opt/rpxdock:/opt/willutil /opt/rpx-env/bin/python -c 'import rpxdock; print("rpxdock import OK")'
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/rpx-env/bin:$PATH
    export PYTHONPATH=/opt/rpxdock:/opt/willutil
    export VIRTUAL_ENV=/opt/rpx-env

%labels
    Source wills heffler rpxdock
    Version 61264c6cbaae882bf52d6547cd2d40b6ed4de0d9

%runscript
    exec "$@"
