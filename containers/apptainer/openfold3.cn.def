BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/openfold3/files/0/wheels /opt/wheels
    /home/user/data/apptainer/sources/openfold3/repos/0/openfold-3-main /opt/openfold3

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The repo is staged from a source tarball: this host's git URL rewrite and
    # repeated GitHub disconnects make cloning it unreliable.
    python3.12 -m venv /opt/openfold3-env
    /opt/openfold3-env/bin/pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    /opt/openfold3-env/bin/pip install --upgrade pip setuptools wheel

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The torch cu126 closure is staged on the host. Torch 2.14 pulls the
    # cuda-toolkit[...] metapackage, so the staged set is the complete closure --
    # install it with --no-deps so pip cannot re-resolve anything remotely.
    /opt/openfold3-env/bin/pip install --no-deps /opt/wheels/*.whl
    /opt/openfold3-env/bin/python -c 'import torch; assert torch.version.cuda == "12.6"; print("openfold3 torch", torch.__version__)'

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    cd /opt/openfold3 && /opt/openfold3-env/bin/pip install . 'biotite==1.7.1' && /opt/openfold3-env/bin/pip check
    /opt/openfold3-env/bin/python -c '
import torch
from biotite.structure import AtomArray
from lightning_fabric.utilities.apply_func import move_data_to_device
atoms = AtomArray(65)
result = move_data_to_device({"atoms": atoms, "tensor": torch.ones(1)}, "cpu")
assert result["atoms"] is atoms
assert result["tensor"].device.type == "cpu"
print("openfold3 import OK")
'
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/openfold3-env/bin:$PATH
    export VIRTUAL_ENV=/opt/openfold3-env
    # `apptainer --nv` injects the driver's libcuda into /.singularity.d/libs and
    # --cleanenv wipes the host LD_LIBRARY_PATH.
    export LD_LIBRARY_PATH=/.singularity.d/libs:/opt/openfold3-env/lib

%labels
    Biotite 1.7.1
    CUDA 12.6
    Version 0d25195edec495f3e0e94fd68be86d4458c246e7

%runscript
    exec "$@"
