BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/rfdiffusion1/files/0/cuda-repo /opt/cuda-repo
    /home/user/data/apptainer/sources/rfdiffusion1/files/0/wheels /opt/wheels
    /home/user/data/apptainer/sources/rfdiffusion1/repos/0/RFdiffusion /opt/RFdiffusion

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The NVIDIA CDN truncates Packages.gz at exactly 1 MiB on this network, so
    # apt cannot read the remote index; the closure is served from a flat local repo.
    echo "deb [trusted=yes] file:///opt/cuda-repo ./" > /etc/apt/sources.list.d/cuda-local.list
    printf 'Acquire::Retries "5";\nAcquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99chaperone-retries
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-12-8
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    python3.12 -m venv /opt/rfd1-env
    . /opt/rfd1-env/bin/activate && pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    . /opt/rfd1-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The repo is staged on the host at the pinned revision (checked out before
    # the build), so no clone or checkout runs inside the sandbox.
    test "$(git -C /opt/RFdiffusion rev-parse HEAD)" = "86507b6538f51fce57b5a72477165f03999ed7ae"
    # torch 2.4.0+cu124 and dgl 2.4.0+cu124 are staged on the host: the DGL index
    # and the torch CUDA index throttle badly inside the sandbox, and DGL has no
    # usable wheel on PyPI for this torch version.
    . /opt/rfd1-env/bin/activate && pip install --no-deps /opt/wheels/torch-*.whl /opt/wheels/dgl-*.whl
    # torch + dgl pure-Python deps. dgl import pulls psutil at module load, so
    # --no-deps alone leaves it broken; pandas/scipy/pydantic are also declared.
    . /opt/rfd1-env/bin/activate && pip install filelock fsspec jinja2 networkx sympy typing-extensions setuptools numpy==1.26.4 psutil packaging pyyaml requests scipy pandas pydantic tqdm

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    . /opt/rfd1-env/bin/activate && pip install --no-cache-dir wandb pynvml decorator
    . /opt/rfd1-env/bin/activate && pip install --no-cache-dir hydra-core pyrsistent icecream opt-einsum 'e3nn==0.5.1'

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # SE3Transformer builds against the installed torch/dgl; it needs the venv's
    # torch headers, hence --no-build-isolation.
    . /opt/rfd1-env/bin/activate && cd /opt/RFdiffusion/env/SE3Transformer && \
        pip install --no-build-isolation --no-cache-dir .
    . /opt/rfd1-env/bin/activate && DGLBACKEND=pytorch PYTHONPATH=/opt/RFdiffusion /opt/rfd1-env/bin/python -c '
import torch, dgl
import rfdiffusion.inference.model_runners
assert torch.__version__ == "2.4.0+cu124", torch.__version__
assert dgl.__version__ == "2.4.0+cu124", dgl.__version__
print("rfd1 torch", torch.__version__, "dgl", dgl.__version__)
'

%post
    cd /
    # Weights are mounted at runtime from RFDIFFUSION_WEIGHTS_DIR; schedules are
    # writable scratch that RFdiffusion generates on first use.
    mkdir -p /opt/RFdiffusion/models /opt/RFdiffusion/schedules
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/rfd1-env/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export CUDA_HOME=/usr/local/cuda
    export VIRTUAL_ENV=/opt/rfd1-env
    export DGLBACKEND=pytorch
    export PYTHONPATH=/opt/RFdiffusion:$PYTHONPATH

%labels
    CUDA 12.4
    PyTorch 2.4.0
    RFdiffusion 86507b6538f51fce57b5a72477165f03999ed7ae

%runscript
    exec "$@"
