BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/foundry/repos/0/foundry /opt/foundry
    /home/user/data/apptainer/sources/foundry/files/0/cuda-repo /opt/cuda-repo
    /home/user/data/apptainer/sources/foundry/files/0/wheels /opt/wheels

%post
    . /.singularity.d/env/10-docker*.sh

    # Use China mirrors for apt. Plain HTTP: base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        libaio-dev \
        ninja-build \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The NVIDIA CDN truncates Packages.gz at exactly 1 MiB on this network, so apt
    # cannot read the remote index. The dependency closure was downloaded on the host
    # into /opt/cuda-repo (a flat local apt repository) and is installed from there.
    echo "deb [trusted=yes] file:///opt/cuda-repo ./" > /etc/apt/sources.list.d/cuda-local.list
    rm -f /etc/apt/sources.list.d/cuda.list
    mkdir -p /etc/apt/apt.conf.d
    printf 'Acquire::Retries "5";\nAcquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99chaperone-retries
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-12-8
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    python3.12 -m venv /opt/foundry-env
    . /opt/foundry-env/bin/activate && pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    . /opt/foundry-env/bin/activate && pip install --upgrade pip setuptools wheel
    # torch cu128 is staged on the host: the Aliyun mirror throttles this 820 MB
    # wheel inside the build sandbox even though the host fetches it at ~11 MB/s.
    . /opt/foundry-env/bin/activate && pip install /opt/wheels/torch-2.11.0+cu128-cp312-cp312-manylinux_2_28_x86_64.whl --extra-index-url https://pypi.tuna.tsinghua.edu.cn/simple

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    git config --global --add safe.directory /opt/foundry
    . /opt/foundry-env/bin/activate && cd /opt/foundry && pip install -e '.[all]' 'atomworks[ml]==3.0.1' 'biotite==1.6.0' 'lightning==2.6.1' 'numpy==2.4.3'
    . /opt/foundry-env/bin/activate && rfd3na --help >/dev/null

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    export CUDA_HOME=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    . /opt/foundry-env/bin/activate && pip check
    /opt/foundry-env/bin/python -c 'import torch; assert torch.version.cuda == "12.8"; print(torch.__version__, torch.version.cuda)'
    /opt/foundry-env/bin/python -c 'from importlib.metadata import version; assert version("rc-foundry") == "1.0.0"; assert version("atomworks") == "3.0.1"; assert version("biotite") == "1.6.0"; import rfd3.engine; import rfd3na.engine; import rf3.inference_engines.rf3; import mpnn.inference_engines.mpnn'
    /opt/foundry-env/bin/python -c 'from rfd3na.inference.input_parsing import DesignInputSpecification; from biotite.structure import get_residue_starts; from rf3.inference_engines.rf3 import RF3InferenceEngine; atoms = DesignInputSpecification(contig="2,/0,3R,/0,4D", length="9").build(); assert len(get_residue_starts(atoms)) == 9; assert RF3InferenceEngine(ckpt_path="unused.ckpt").transform_overrides["residue_cache_dir"] is None'

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64
    export PATH=/opt/foundry-env/bin:/usr/local/cuda/bin:$PATH
    export VIRTUAL_ENV=/opt/foundry-env

%labels
    AtomWorks 3.0.1
    CUDA 12.8
    Foundry 1.0.0
    PyTorch 2.11.0
    RF3ResidueCache disabled-for-inference
    Version 54d188b3c0c27654a01c875b173148a508fcd858

%runscript
    exec "$@"
