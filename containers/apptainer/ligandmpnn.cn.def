BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif
%post
    . /.singularity.d/env/10-docker*.sh

%post
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%files
    /home/user/data/apptainer/sources/ligandmpnn/repos/0/LigandMPNN /opt/ligandmpnn
    /home/user/data/apptainer/sources/ligandmpnn/files/0/model_params /opt/mpnn-weights
    /home/user/data/apptainer/sources/ligandmpnn/files/0/site-packages /opt/mpnn-torch

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    python3.12 -m venv /opt/mpnn-env
    /opt/mpnn-env/bin/pip install --upgrade pip setuptools wheel
    /opt/mpnn-env/bin/pip install numpy==1.26.4 prody==2.6.1 scipy biopython ml-collections dm-tree --index-url https://pypi.tuna.tsinghua.edu.cn/simple
    SP=$(/opt/mpnn-env/bin/python -c "import sysconfig;print(sysconfig.get_paths()['purelib'])")
    cp -r /opt/mpnn-torch/. "$SP"/

%post
    cd /
    git -C /opt/ligandmpnn checkout 26ec57ac976ade5379920dbd43c7f97a91cf82de
    /opt/mpnn-env/bin/python -c '
from pathlib import Path
import re
root = Path('"'"'/opt/ligandmpnn'"'"') / "openfold"
for filename, alias, expected in [
    ("np/residue_constants.py", "int", 3),
    ("data/templates.py", "object", 2),
    ("np/relax/utils.py", "bool", 1),
]:
    path = root / filename
    source = path.read_text()
    patched, count = re.subn(r"\bnp\." + alias + r"\b", alias, source)
    if count != expected:
        raise RuntimeError(f"Unexpected NumPy alias count in {path}: {count}, expected {expected}")
    path.write_text(patched)
'
    mkdir -p /opt/ligandmpnn/model_params
    cp /opt/mpnn-weights/*.pt /opt/ligandmpnn/model_params/
    cd /opt/ligandmpnn/model_params && sha256sum -c /opt/mpnn-weights/SHA256SUMS

%environment
    export PATH=/opt/mpnn-env/bin:$PATH
    export PYTHONPATH=/opt/ligandmpnn
    export VIRTUAL_ENV=/opt/mpnn-env
%post
    export PATH=/opt/mpnn-env/bin:$PATH
    export PYTHONPATH=/opt/ligandmpnn
    export VIRTUAL_ENV=/opt/mpnn-env

%labels
    CUDA 12.8
    License MIT
    Version LigandMPNN-26ec57ac976ade5379920dbd43c7f97a91cf82de

%runscript
    exec "$@"
