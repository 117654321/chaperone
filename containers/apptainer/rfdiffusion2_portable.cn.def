BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

# The RFdiffusion2 stack is resolved and installed on the host and copied in as
# a finished tree. Doing it inside the build sandbox is not workable: conda's
# classic solver spent >30 min without converging on the four-channel pin
# (nvidia cuda-12.4.0 + rosettacommons + pytorch + dglteam), and the
# rosettacommons CDN serves the 1.5 GB pyrosetta package at ~30 KB/s with
# repeated TLS resets.
%files
    /home/user/data/apptainer/sources/rfdiffusion2_portable/files/0/env /opt/rfd2-env
    /home/user/data/apptainer/sources/rfdiffusion2_portable/files/0/misc/cutlass-v3.5.1.tar.gz /opt/stage/cutlass-v3.5.1.tar.gz
    /home/user/data/apptainer/sources/rfdiffusion2_portable/files/0/weights/RFD_173.pt /opt/rfd2-weights/RFD_173.pt
    /home/user/data/apptainer/sources/rfdiffusion2_portable/repos/0/RFdiffusion2 /opt/RFdiffusion2

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bzip2 \
        ca-certificates \
        curl \
        git \
        libaio-dev \
        libjpeg-dev \
        libpng-dev \
        libx11-6 \
        libxau6 \
        libxext6 \
        libxrender1
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    mkdir -p /opt/cutlass
    tar xzf /opt/stage/cutlass-v3.5.1.tar.gz -C /opt/cutlass --strip-components=1
    rm -rf /opt/stage

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The checkpoint is staged from a copy whose hash already matched upstream's
    # published file; verify it again in place.
    echo '590e126057f780afc1249d29545f0f90635562b1a3df5aff013afcfc39c3d3c3  /opt/rfd2-weights/RFD_173.pt' | sha256sum -c -
    test "$(git -C /opt/RFdiffusion2 rev-parse HEAD)" = "d365cbf4db3958814a9f8e4f6f94fa309dfebc2b"
    # The copied env must still import its native extensions against the host
    # glibc; this catches a bad copy before the image is sealed.
    CUTLASS_PATH=/opt/cutlass PYTHONPATH=/opt/RFdiffusion2 \
    BABEL_LIBDIR=/opt/rfd2-env/lib/openbabel/3.1.0 \
    BABEL_DATADIR=/opt/rfd2-env/share/openbabel/3.1.0 \
    /opt/rfd2-env/bin/python -c '
import torch, dgl, pyrosetta, deepspeed
import torch_scatter, torch_sparse, torch_cluster, torch_spline_conv
from openbabel import pybel
import rf_diffusion
from rf_diffusion import run_inference
assert torch.__version__ == "2.4.0", torch.__version__
assert dgl.__version__ == "2.4.0+cu124", dgl.__version__
print("rfd2 stack OK", torch.__version__, dgl.__version__, deepspeed.__version__)
'
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUTLASS_PATH=/opt/cutlass/
    export MKL_SERVICE_FORCE_INTEL=1
    export PATH=/opt/rfd2-env/bin:$PATH
    export PYTHONPATH=/opt/RFdiffusion2
    export DGLBACKEND=pytorch
    # openbabel loads its format plugins at import time. Without these it prints
    # "Unable to find OpenBabel plugins" and pybel dies on a format-table parse,
    # which takes down rf2aa's data loader and therefore the whole import chain.
    export BABEL_LIBDIR=/opt/rfd2-env/lib/openbabel/3.1.0
    export BABEL_DATADIR=/opt/rfd2-env/share/openbabel/3.1.0

%labels
    CUDA 12.4
    Source RosettaCommons/RFdiffusion2
    Version d365cbf

%runscript
    exec python "$@"
