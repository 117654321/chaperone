BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/esm2/files/0/cuda-repo /opt/cuda-repo
    /home/user/data/apptainer/sources/esm2/files/0/wheels /opt/wheels

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The NVIDIA CDN truncates Packages.gz at exactly 1 MiB on this network, so
    # apt cannot read the remote index; the closure is served from a flat local repo.
    echo "deb [trusted=yes] file:///opt/cuda-repo ./" > /etc/apt/sources.list.d/cuda-local.list
    printf 'Acquire::Retries "5";\nAcquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99chaperone-retries
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-12-8
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    python3.12 -m venv /opt/esm2-env
    . /opt/esm2-env/bin/activate && pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    . /opt/esm2-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The torch cu126 closure is staged on the host: the mirror throttles these
    # wheels inside the build sandbox. Install with --no-deps so pip cannot
    # re-resolve them remotely, then add torch's pure-Python deps from the index.
    . /opt/esm2-env/bin/activate && pip install --no-deps /opt/wheels/torch-*.whl /opt/wheels/nvidia_*.whl /opt/wheels/triton-*.whl
    . /opt/esm2-env/bin/activate && pip install filelock fsspec jinja2 networkx sympy typing-extensions setuptools
    . /opt/esm2-env/bin/activate && /opt/esm2-env/bin/python -c 'import torch; assert torch.version.cuda == "12.6"; print("esm2 torch", torch.__version__)'

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # esm2 block drives ESM-2 through transformers, so the package set is small.
    # socksio: this site sets all_proxy=socks5, which Apptainer forwards into the
    # container; huggingface_hub's httpx client then refuses to start without it.
    . /opt/esm2-env/bin/activate && pip install transformers safetensors click 'httpx[socks]' 'huggingface_hub[hf_transfer]'
    . /opt/esm2-env/bin/activate && /opt/esm2-env/bin/python -c '
import torch, transformers
from transformers import AutoModel, AutoTokenizer
print("transformers", transformers.__version__, "torch", torch.__version__)
'

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/esm2-env/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export CUDA_HOME=/usr/local/cuda
    export VIRTUAL_ENV=/opt/esm2-env

%labels
    CUDA 12.6
    PyTorch 2.9.1

%runscript
    exec "$@"
