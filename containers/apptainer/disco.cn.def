BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

# The DISCO python env is resolved and installed on the host with uv and copied
# in as a finished tree: its pyproject pins torch 2.11/cu128 through
# [tool.uv.sources], and deepspeed builds against the venv's torch, which is
# impractical to reproduce inside the build sandbox.
%files
    /home/user/data/apptainer/sources/disco/files/0/uv-python /opt/uv-python
    /home/user/data/apptainer/sources/disco/files/0/hf /opt/hf-cache
    /home/user/data/apptainer/sources/disco/repos/0/DISCO /opt/disco

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libx11-6 \
        libxext6 \
        libxrender1
    rm -rf /var/lib/apt/lists/*

%post
    cd /opt/disco
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY LD_LIBRARY_PATH
    export no_proxy='*' NO_PROXY='*'
    # openfold/model/primitives.py calls importlib.util.find_spec but only does
    # `import importlib`. Pre-seeding importlib.util in a sitecustomize keeps the
    # pinned upstream source untouched.
    cat > /opt/disco/.venv/lib/python3.12/site-packages/sitecustomize.py <<'PY'
# openfold imports `importlib` and then uses `importlib.util`, which is not an
# attribute of the package unless something else already imported the submodule.
import importlib.util  # noqa: F401
PY
    # The uv venv hard-links its interpreter to the host's uv-managed CPython
    # (/home/user/.local/share/uv/python/...), which does not exist here. Repoint
    # it at the copy staged next to the repo and rewrite pyvenv.cfg's home, or
    # every interpreter start dies with "No module named 'encodings'".
    ln -sfn /opt/uv-python/bin/python3.12 /opt/disco/.venv/bin/python
    ln -sfn python /opt/disco/.venv/bin/python3
    ln -sfn python /opt/disco/.venv/bin/python3.12
    sed -i 's|^home = .*|home = /opt/uv-python/bin|' /opt/disco/.venv/pyvenv.cfg
    /opt/disco/.venv/bin/python -c 'import sys; print("disco python prefix", sys.prefix)'
    # Verify the whole import chain. deepspeed JIT-builds its ops on first
    # import, so this is slow but must succeed. disco/data/ccd.py downloads the
    # CCD components from the Hub at import time, so point the cache at the
    # staged copy and go offline.
    HF_HUB_CACHE=/opt/hf-cache HF_HUB_OFFLINE=1 \
    LD_LIBRARY_PATH=/.singularity.d/libs:/opt/disco/.venv/lib \
    /opt/disco/.venv/bin/python -c '
import torch
import runner.inference
assert torch.version.cuda == "12.8", torch.version.cuda
print("disco stack OK", torch.__version__)
'
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUTLASS_PATH=/opt/disco
    export PATH=/opt/disco/.venv/bin:$PATH
    export PYTHONPATH=/opt/disco:$PYTHONPATH
    export VIRTUAL_ENV=/opt/disco/.venv
    export LD_LIBRARY_PATH=/.singularity.d/libs:/opt/disco/.venv/lib
    # disco/data/ccd.py fetches CCD components from the Hub at import time; the
    # image carries a pre-populated cache so runs never need the network.
    export HF_HUB_CACHE=/opt/hf-cache
    export HF_HUB_OFFLINE=1

%labels
    CUDA 12.8
    PyTorch 2.11.0
    Version 398098c57e3f1dd6dd6205c059f7792dcc9b9147

%runscript
    exec "$@"
