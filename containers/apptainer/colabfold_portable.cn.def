BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

# The ColabFold stack is resolved on the host and copied in as a finished tree.
# Two files in this stack cannot be fetched inside the build sandbox: the
# cublas/cudnn/pjrt wheels (hundreds of MB at ~200 kB/s) and the ColabFold repo
# itself (the site's git URL rewrite breaks pip's clone).

%files
    /home/user/data/apptainer/sources/colabfold_portable/files/0/env /opt/conda
    /home/user/data/apptainer/sources/colabfold_portable/repos/0/ColabFold /opt/ColabFold

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libx11-6 \
        libxext6 \
        libxrender1 \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY LD_LIBRARY_PATH
    export no_proxy='*' NO_PROXY='*'
    # The env was built at /tmp/cf-env and is installed at /opt/conda, so every
    # console script still has the build-time interpreter path in its shebang
    # and exec fails with "no such file or directory". Rewrite them all, then
    # repoint the env's recorded prefix so conda/pip stay self-consistent.
    grep -rlZ '^#!/tmp/cf-env/bin/' /opt/conda/bin 2>/dev/null \
        | xargs -0 -r sed -i '1s|^#!/tmp/cf-env/bin/|#!/opt/conda/bin/|'
    for f in /opt/conda/bin/*; do
        if [ -f "$f" ] && head -1 "$f" 2>/dev/null | grep -q '^#!/tmp/cf-env'; then
            sed -i '1s|^#!/tmp/cf-env/bin/|#!/opt/conda/bin/|' "$f"
        fi
    done
    grep -rlZ '/tmp/cf-env' /opt/conda/conda-meta 2>/dev/null \
        | xargs -0 -r sed -i 's|/tmp/cf-env|/opt/conda|g'
    # Verify the copied env still imports in place. JAX probes CUDA at import
    # time and the build has no device, so force the CPU backend for this probe;
    # GPU use is checked when the block actually runs.
    JAX_PLATFORMS=cpu env -u LD_LIBRARY_PATH /opt/conda/bin/python -c '
import jax
jax.config.update("jax_platforms", "cpu")
import colabfold
import jax.numpy as jnp
import h5py, haiku, ml_collections
assert float(jnp.sum(jnp.ones((8, 8)))) == 64.0
print("colabfold stack OK", jax.__version__)
'
    /opt/conda/bin/colabfold_batch --help > /dev/null && echo "colabfold_batch OK"
    echo "/opt/conda/lib" > /etc/ld.so.conf.d/conda.conf && ldconfig
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/conda/bin:$PATH
    export PYTHONNOUSERSITE=1
    # XLA needs ptxas to compile PTX for the GPU. The nvidia-cuda-nvcc pip
    # package carries one under site-packages/nvidia/cuda_nvcc/bin; without it
    # JAX aborts with "No PTX compilation provider is available".
    export PATH=/opt/conda/lib/python3.11/site-packages/nvidia/cuda_nvcc/bin:$PATH
    export XLA_FLAGS=--xla_gpu_cuda_data_dir=/opt/conda/lib/python3.11/site-packages/nvidia/cuda_nvcc
    # `apptainer --nv` injects the driver's libcuda into /.singularity.d/libs,
    # and --cleanenv wipes the host LD_LIBRARY_PATH. JAX's cuda12 plugin loads
    # cudart/cublas/cudnn from the nvidia-* pip packages under
    # site-packages/nvidia/*/lib and does not add those dirs to the loader path
    # itself; without them it finds the device but every cuDNN call fails with
    # "Error loading CUDA libraries".
    export LD_LIBRARY_PATH=/opt/conda/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cufft/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cusolver/lib:/opt/conda/lib/python3.11/site-packages/nvidia/cusparse/lib:/opt/conda/lib/python3.11/site-packages/nvidia/nccl/lib:/opt/conda/lib/python3.11/site-packages/nvidia/nvjitlink/lib:/.singularity.d/libs:/opt/conda/lib

%labels
    CUDA 12.8
    Version colabfold-v1.6.1

%runscript
    exec "$@"
