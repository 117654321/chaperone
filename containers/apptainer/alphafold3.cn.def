BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/alphafold3/repos/0/alphafold3 /opt/alphafold3

%files
    /home/user/data/apptainer/sources/alphafold3/files/0/run_alphafold_AF.py /opt/chaperone-build-smoke/run_alphafold_AF.py

%files
    /home/user/data/apptainer/sources/alphafold3/files/0/cuda-repo /opt/cuda-repo

%files
    /home/user/data/apptainer/sources/alphafold3/files/0/hmmer /opt/hmmer_src

%files
    /home/user/data/apptainer/sources/alphafold3/files/0/cmake_deps /opt/cmake-deps

%post
    . /.singularity.d/env/10-docker*.sh

    # Use China mirrors for apt. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        gnupg \
        libx11-6 \
        libxau6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        patch \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget \
        zlib1g-dev
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The NVIDIA CDN truncates Packages.gz at exactly 1 MiB on this network, so apt
    # cannot read the remote index. The dependency closure was fetched on the host
    # into a flat local repository instead.
    echo "deb [trusted=yes] file:///opt/cuda-repo ./" > /etc/apt/sources.list.d/cuda-local.list
    mkdir -p /etc/apt/apt.conf.d
    printf 'Acquire::Retries "5";\nAcquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99chaperone-retries
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-toolkit-12-8
    rm -rf /var/lib/apt/lists/*

%post
    cd /opt/alphafold3
    git checkout --detach 37e3c57fe123fc51f6d96236320b8b657afb11ac

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # HMMER is staged on the host: eddylab.org is slow and sometimes unreachable
    # from the build sandbox.
    mkdir -p /usr/local/hmmer
    cp -r /opt/hmmer_src /opt/hmmer_build
    cd /opt/hmmer_build && echo 'ca70d94fd0cf271bd7063423aabb116d42de533117343a9b27a65c17ff06fbf3 hmmer-3.4.tar.gz' | sha256sum --check
    cd /opt/hmmer_build && tar zxf hmmer-3.4.tar.gz && rm hmmer-3.4.tar.gz
    cd /opt/hmmer_build && patch -p0 < /opt/alphafold3/docker/jackhmmer_seq_limit.patch
    cd /opt/hmmer_build/hmmer-3.4 && ./configure --prefix /usr/local/hmmer && make -j16 && make install
    cd /opt/hmmer_build/hmmer-3.4/easel && make install
    rm -rf /opt/hmmer_build /opt/hmmer_src

%post
    cd /
    # uv.lock pins every package to an absolute https://files.pythonhosted.org URL.
    # `--frozen` obeys those URLs verbatim, so UV_INDEX_URL / UV_DEFAULT_INDEX do
    # nothing and the download goes straight to the Fastly CDN: measured 56 KB/s
    # here, which is ~3 h for the 3 GB CUDA stack (observed: 1 h to reach 300 MB).
    #
    # Passing `--index-url` instead makes uv treat the lock as stale ("Resolving
    # despite existing lockfile due to missing remote index") and re-resolve
    # against the mirror, which measures ~20 MB/s. The resolved versions are
    # still pinned by pyproject's `==` specs, so only the download host changes.
    #
    # The build shares the host network namespace, so a host-local proxy is
    # reachable at 127.0.0.1 and makes pythonhosted fast on hosts that need one.
    # Probe rather than assume: no proxy means the port is closed and we fall
    # through to a direct download.
    PROXY=http://127.0.0.1:7890
    if timeout 3 bash -c "echo > /dev/tcp/127.0.0.1/7890" 2>/dev/null; then
        echo "uv: using proxy $PROXY"
        export http_proxy=$PROXY https_proxy=$PROXY all_proxy=socks5://127.0.0.1:7890
        unset no_proxy NO_PROXY
    else
        echo "uv: no proxy on 127.0.0.1:7890, downloading directly"
        unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
        export no_proxy='*' NO_PROXY='*'
    fi
    export UV_HTTP_TIMEOUT=600
    python3.12 -m venv /opt/uv-env && /opt/uv-env/bin/pip install uv==0.9.24 --index-url https://pypi.tuna.tsinghua.edu.cn/simple
    cd /opt/alphafold3 && UV_PROJECT_ENVIRONMENT=/opt/af3-env /opt/uv-env/bin/uv sync \
        --no-dev --no-editable \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple
    /opt/uv-env/bin/uv pip check --python /opt/af3-env/bin/python
    unset http_proxy https_proxy all_proxy
    /opt/af3-env/bin/build_data

%post
    cd /
    for d in /opt/af3-env/lib/python3.12/site-packages/nvidia/*/lib; do for f in "$d"/*.so*; do [ -f "$f" ] && ln -sf "$f" /usr/local/cuda/lib64/; done; done
    for m in cuda_runtime cublas cusparse cudnn cufft cusolver nccl nvjitlink; do echo /opt/af3-env/lib/python3.12/site-packages/nvidia/$m/lib >> /etc/ld.so.conf.d/nvidia-pip.conf; done
    echo /usr/local/cuda/lib64 >> /etc/ld.so.conf.d/nvidia-pip.conf
    ldconfig

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    export PATH=/opt/af3-env/bin:/usr/local/cuda/bin:/usr/local/hmmer/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    export VIRTUAL_ENV=/opt/af3-env
    JAX_PLATFORMS=cpu /opt/af3-env/bin/python -c "import runpy; runpy.run_path('/opt/chaperone-build-smoke/run_alphafold_AF.py', run_name='chaperone_build_smoke')"

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/opt/af3-env/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/cublas/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/cusparse/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/cufft/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/cusolver/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/nccl/lib:/opt/af3-env/lib/python3.12/site-packages/nvidia/nvjitlink/lib:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PATH=/opt/af3-env/bin:/usr/local/cuda/bin:/usr/local/hmmer/bin:$PATH
    export TF_ENABLE_ONEDNN_OPTS=0
    export VIRTUAL_ENV=/opt/af3-env
    export XLA_CLIENT_MEM_FRACTION=0.95
    export XLA_FLAGS=--xla_gpu_enable_triton_gemm=false
    export XLA_PYTHON_CLIENT_PREALLOCATE=true

%labels
    CUDA 12.8-toolkit/12.9-wheels
    Version 37e3c57fe123fc51f6d96236320b8b657afb11ac

%runscript
    exec "$@"
