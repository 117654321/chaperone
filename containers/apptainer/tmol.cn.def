BootStrap: localimage
From: /home/user/data/apptainer/ubuntu2404.sif

%files
    /home/user/data/apptainer/sources/tmol/files/0/wheels /opt/wheels

%post
    . /.singularity.d/env/10-docker*.sh

    # China mirrors. Plain HTTP: the base image has no ca-certificates yet.
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list 2>/dev/null || true
    apt-get update -y
    # No CUDA toolkit: tmol ships prebuilt AOT .so kernels, torch bundles its own
    # CUDA runtime, and libcuda comes from the host driver via `apptainer --nv`.
    # libX11/libXext/libXrender are needed by openbabel's format plugins (the
    # `[ligand]` extra) even in headless use.
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        libx11-6 \
        libxext6 \
        libxrender1 \
        python3-pip \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        wget
    rm -rf /var/lib/apt/lists/*

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    python3.12 -m venv /opt/tmol-env
    . /opt/tmol-env/bin/activate && pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple
    . /opt/tmol-env/bin/activate && pip install --upgrade pip setuptools wheel

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # The torch cu128 closure is staged on the host: the mirror throttles these
    # wheels inside the build sandbox. Install them with --no-deps so pip cannot
    # re-resolve and re-download them, then add torch's pure-Python deps from the
    # index. --no-index alone would fail: filelock and friends are not in the
    # staged directory.
    . /opt/tmol-env/bin/activate && pip install --no-deps /opt/wheels/torch-*.whl /opt/wheels/nvidia_*.whl /opt/wheels/triton-*.whl /opt/wheels/cuda_bindings-*.whl
    # torch + cuda-bindings pure-Python deps; not in the staged directory, so
    # --no-index would fail on them.
    . /opt/tmol-env/bin/activate && pip install filelock fsspec jinja2 networkx sympy typing-extensions setuptools cuda-pathfinder

%post
    cd /
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY
    export no_proxy='*' NO_PROXY='*'
    # tmol ships an sdist on PyPI whose custom PEP 517 backend auto-downloads an
    # AOT wheel from GitHub Releases, choosing a lane from the *installed* torch.
    # That detection is unreliable inside pip's isolated build env, so install
    # the exact prebuilt wheel by path and skip the backend entirely. Its
    # dependencies ARE resolved normally: --no-deps here leaves frozendict et al
    # missing at import time. torch is already satisfied, so pip will not pull a
    # CPU build over the cu128 one.
    . /opt/tmol-env/bin/activate && pip install '/opt/wheels/tmol-0.1.35+cu128torch2.10-cp312-cp312-linux_x86_64.whl[ligand]'
    . /opt/tmol-env/bin/activate && /opt/tmol-env/bin/python -c '
import torch, tmol
from tmol.io import pose_stack_from_biotite
assert torch.__version__.startswith("2.10.0"), torch.__version__
print("tmol", tmol.__version__, "torch", torch.__version__)
'

%post
    cd /
    apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache/pip

%environment
    export PATH=/opt/tmol-env/bin:$PATH
    export VIRTUAL_ENV=/opt/tmol-env
    export PYTORCH_ALLOC_CONF=expandable_segments:True

%labels
    CUDA 12.8
    PyTorch 2.10.0
    Tmol 0.1.35

%runscript
    exec "$@"
